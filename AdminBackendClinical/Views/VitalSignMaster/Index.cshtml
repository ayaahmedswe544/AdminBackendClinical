@using ServiceLayer.VitalSignMaster.DTOs
@model IEnumerable<VitalSignMasterWithVitalSignsDto>

@{
    ViewData["Title"] = "Vital Sign Masters";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Vital Sign Masters</h2>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus"></i>
            Add Vital Sign Master
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="table-responsive">

        <table class="table table-bordered table-hover align-middle">

            <thead class="table-dark">
                <tr>
                    <th style="width: 60px;">#</th>
                    <th>Name</th>
                    <th style="width: 350px;">Actions</th>
                </tr>
            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    int index = 1;

                    foreach (var master in Model)
                    {
                        var collapseId = $"vitalSigns_{index}";
                        <tr>

                            <td>
                                @index
                            </td>

                            <td>
                                <strong>@master.Name</strong>
                            </td>

                            <td>

                                <div class="d-flex gap-2">
                                    <a asp-action="Edit"
                                       asp-route-id="@master.ID"
                                       class="btn btn-sm btn-warning">
                                        Edit
                                    </a>
                                    <form asp-action="Delete"
                                          asp-route-id="@master.ID"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to delete this Vital Sign Master?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-danger">
                                            Delete
                                        </button>

                                    </form>
                                    <button type="button"
                                            class="btn btn-sm btn-info"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#@collapseId"
                                            aria-expanded="false"
                                            aria-controls="@collapseId">

                                        Show Signs
                                    </button>

                                </div>

                            </td>

                        </tr>
                        <tr>

                            <td colspan="3" class="p-0">

                                <div id="@collapseId"
                                     class="collapse">

                                    <div class="p-3 bg-light">

                                        @if (master.VitalSigns != null &&
                                             master.VitalSigns.Any())
                                        {
                                            <table class="table table-sm table-bordered mb-0">

                                                <thead class="table-secondary">
                                                    <tr>
                                                        <th>Name</th>
                                                        <th>Description</th>
                                                        <th>Data Type</th>
                                                        <th style="width: 100px;">
                                                            Action
                                                        </th>
                                                    </tr>
                                                </thead>

                                                <tbody>

                                                    @foreach (var sign in master.VitalSigns)
                                                    {
                                                        <tr>

                                                            <td>
                                                                @sign.name
                                                            </td>

                                                            <td>
                                                                @sign.description
                                                            </td>

                                                            <td>
                                                                @sign.dataTypeName
                                                            </td>

                                                            <td>

                                                                <a asp-action="ViewSign"
                                                                   asp-route-id="@sign.ID"
                                                                   class="btn btn-sm btn-primary">
                                                                    View
                                                                </a>

                                                            </td>

                                                        </tr>
                                                    }

                                                </tbody>

                                            </table>
                                        }
                                        else
                                        {
                                            <div class="text-muted text-center p-3">
                                                No vital signs found for this master.
                                            </div>
                                        }

                                    </div>

                                </div>

                            </td>

                        </tr>

                        index++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3"
                            class="text-center text-muted py-4">

                            No Vital Sign Masters found.

                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

